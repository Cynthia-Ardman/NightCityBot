modules = ["python-3.11", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "coverage"

[[workflows.workflow]]
name = "bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install -r requirements.txt && python -m NightCityBot.bot"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m pytest NightCityBot/tests/ -q --tb=short"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "coverage"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m pytest NightCityBot/tests/ -q --tb=short --cov=NightCityBot --cov-report=term-missing --cov-fail-under=63"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["python", "-m", "NightCityBot.bot"]
ignorePorts = true
build = ["pip", "install", "-r", "requirements.txt"]

[nix]
packages = ["lsof", "postgresql", "rapidfuzz-cpp", "taskflow"]
channel = "stable-25_05"


[agent]
expertMode = true
