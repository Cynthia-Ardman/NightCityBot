modules = ["python-3.11", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "bot"

[[workflows.workflow]]
name = "bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install -r requirements.txt && python -m NightCityBot.bot"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["python", "-m", "NightCityBot.bot"]
ignorePorts = true
build = ["pip", "install", "-r", "requirements.txt"]

[nix]
packages = ["lsof"]
channel = "stable-25_05"


[agent]
expertMode = true
